# Source data — never commit (PHI risk even after anonymization)
data/raw/*
!data/raw/.gitkeep

# Generated outputs
output/
*.csv
!examples/**/*.csv
!tests/**/*.csv

# JSON / NDJSON outputs — generally ignore, but commit small samples under examples/
*.ndjson
!examples/**/*.ndjson
!examples/**/*.json

# Trained model artifacts (runtime; src/syntha/models/ is source code and IS tracked)
*.pkl
*.joblib

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
