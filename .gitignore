*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
