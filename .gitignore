# Source data — never commit (PHI risk even after anonymization)
data/raw/*
!data/raw/.gitkeep

# Generated outputs
output/
*.csv
!examples/**/*.csv
!tests/**/*.csv

# JSON / NDJSON outputs — generally ignore, but commit small samples under examples/
# and the Tauri app's bundled model assets (which are regenerated by CI).
*.ndjson
!examples/**/*.ndjson
!examples/**/*.json
!app/src/model_*.json

# Tauri / Node — app/.gitignore handles the rest
app/node_modules/
app/dist/
app/src-tauri/target/
app/src-tauri/gen/

# Trained model artifacts (runtime; src/syntha/models/ is source code and IS tracked)
*.pkl
*.joblib

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
