<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Tauri / WKWebView under Hardened Runtime + notarization. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- The app reads bundled model JSONs (read-only) and writes a single
         user-chosen CSV download. No microphone, camera, contacts, location,
         or network privileges are requested. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- WKWebView needs this when sandboxed; harmless when not. -->
    <key>com.apple.security.network.client</key>
    <false/>
</dict>
</plist>
