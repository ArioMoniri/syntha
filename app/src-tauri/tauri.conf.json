{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syntha",
  "version": "0.5.10",
  "identifier": "com.ariomoniri.syntha",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "syntha — synthetic patient generator",
        "width": 940,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Synthetic patient record generator",
    "longDescription": "Synthea-inspired hybrid synthetic patient record generator trained on Turkish pristine-healthy EHR cohorts.",
    "copyright": "Copyright (c) 2026 Ariorad Moniri",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "entitlements": "Entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "tsp": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ArioMoniri/syntha/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5RDVEQTUwNTBGQTY2RTEKUldUaFp2cFFVTnJWdVJIZmxaRytXQ0k3bnRQb1JRMEdZQjI2VCtpcVRpU3c4cEtyY3ZJS0tldnQK"
    }
  }
}
